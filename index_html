<!DOCTYPE html>
<html lang="en" dir="ltr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />

  <title>Villa Congre Nº3 — Construction Feasibility & Delivery Study</title>

  <meta
    name="description"
    content="Construction feasibility, technical scope, cost transparency, procurement and delivery study for Villa Congre Nº3, Cala Llamp, Andratx, Mallorca."
  />

  <meta name="theme-color" content="#151a16" />

  <meta property="og:title" content="Villa Congre Nº3" />
  <meta
    property="og:description"
    content="Construction Feasibility & Delivery Study · Cala Llamp · Andratx · Mallorca."
  />

  <style>
    /* =========================================================
       TOKENS
    ========================================================= */

    :root {
      --ivory: #f2efe7;
      --stone: #e7e2d7;
      --paper: #fbfaf6;

      --ink: #1c211d;
      --muted: #5d5d51;

      --olive: #273128;
      --olive-soft: #536151;

      --bronze: #9b8761;
      --bronze-text: #756240;

      --dark: #151a16;
      --light: #f7f4ec;

      --line: rgba(28, 33, 29, 0.18);
      --line-dark: rgba(255, 255, 255, 0.14);

      --serif: Georgia, "Times New Roman", serif;
      --sans: Inter, Arial, Helvetica, sans-serif;

      --max: 1500px;
      --pad: clamp(22px, 5vw, 82px);
    }

    /* =========================================================
       RESET
    ========================================================= */

    * {
      box-sizing: border-box;
    }

    html {
      scroll-behavior: smooth;
      background: var(--ivory);
      color: var(--ink);
    }

    body {
      margin: 0;
      background: var(--ivory);
      font-family: var(--sans);
      line-height: 1.55;
      overflow-x: hidden;
    }

    img {
      display: block;
      max-width: 100%;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button,
    select {
      font: inherit;
    }

    button {
      cursor: pointer;
    }

    figure {
      margin: 0;
    }

    /* =========================================================
       TYPOGRAPHY
    ========================================================= */

    .display {
      margin: 0;
      font-family: var(--serif);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.03em;
    }

    .eyebrow,
    .micro,
    .evidence {
      font-size: 11px;
      line-height: 1.3;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.14em;
    }

    .muted {
      color: var(--muted);
    }

    .lede {
      margin: 0;
      max-width: 840px;
      font-size: clamp(18px, 2vw, 26px);
      line-height: 1.45;
      color: var(--muted);
    }

    .evidence {
      display: inline-flex;
      border: 1px solid currentColor;
      padding: 7px 9px;
      color: var(--bronze-text);
    }

    /* =========================================================
       GLOBAL LAYOUT
    ========================================================= */

    .section {
      width: 100%;
      max-width: var(--max);
      margin: auto;
      padding: clamp(82px, 10vw, 155px) var(--pad);
    }

    .section.full {
      max-width: none;
    }

    .section.soft {
      max-width: none;
      background: var(--stone);
    }

    .section.dark {
      max-width: none;
      background: var(--dark);
      color: var(--light);
    }

    .section-heading {
      display: grid;
      grid-template-columns: 90px 1fr;
      gap: 28px;
      padding-top: 22px;
      margin-bottom: clamp(42px, 6vw, 78px);
      border-top: 1px solid var(--line);
    }

    .dark .section-heading {
      border-color: var(--line-dark);
    }

    .section-number {
      color: var(--bronze-text);
      font-family: var(--serif);
      font-size: 30px;
    }

    .section-heading h2 {
      margin: 0;
      font-family: var(--serif);
      font-weight: 400;
      font-size: clamp(38px, 5vw, 70px);
      line-height: 1.02;
      letter-spacing: -0.03em;
    }

    .two-col {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: clamp(38px, 7vw, 110px);
      align-items: start;
    }

    .three-col {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 24px;
    }

    /* =========================================================
       NAVIGATION
    ========================================================= */

    .nav {
      position: fixed;
      inset: 0 0 auto 0;
      z-index: 100;
      height: 68px;

      display: flex;
      align-items: center;
      gap: 28px;

      padding: 0 var(--pad);

      background: rgba(242, 239, 231, 0.92);
      backdrop-filter: blur(16px);

      border-bottom: 1px solid var(--line);
    }

    .brand {
      white-space: nowrap;
      font-size: 12px;
      font-weight: 800;
      letter-spacing: 0.08em;
    }

    .nav-links {
      display: flex;
      gap: 23px;
      margin-left: auto;
    }

    .nav-links a {
      font-size: 11px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .nav-actions {
      display: flex;
      align-items: center;
      gap: 7px;
    }

    .nav button,
    .nav select {
      min-height: 40px;
      border: 1px solid var(--line);
      background: transparent;
      color: inherit;
      padding: 8px 11px;
    }

    /* =========================================================
       HERO
    ========================================================= */

    .hero {
      position: relative;
      min-height: 100svh;

      display: grid;
      align-items: end;

      background:
        radial-gradient(circle at 70% 30%, #6f796d 0, transparent 30%),
        linear-gradient(135deg, #455247, #161c17 70%);

      color: white;
      overflow: hidden;
    }

    .hero-image {
      position: absolute;
      inset: 0;

      width: 100%;
      height: 100%;

      object-fit: cover;
    }

    .hero::after {
      content: "";
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          180deg,
          rgba(0,0,0,0.12),
          rgba(0,0,0,0.15) 42%,
          rgba(0,0,0,0.76)
        );
    }

    .hero-content {
      position: relative;
      z-index: 2;

      width: 100%;
      max-width: var(--max);
      margin: auto;
      padding: 110px var(--pad) 48px;
    }

    .hero-kicker {
      margin-bottom: 28vh;
    }

    .hero h1 {
      margin: 0;

      max-width: 1150px;

      font-family: var(--serif);
      font-size: clamp(62px, 10.5vw, 160px);
      font-weight: 400;
      line-height: 0.82;
      letter-spacing: -0.055em;
    }

    .hero-meta {
      margin-top: 36px;
      padding-top: 20px;

      display: grid;
      grid-template-columns: 1fr auto;
      gap: 40px;

      border-top: 1px solid rgba(255,255,255,0.45);
    }

    .hero-meta p {
      margin: 0;
    }

    /* =========================================================
       FACT STRIP
    ========================================================= */

    .facts {
      display: grid;
      grid-template-columns: repeat(4, 1fr);

      background: var(--dark);
      color: white;
    }

    .fact {
      min-height: 135px;

      display: flex;
      flex-direction: column;
      justify-content: center;

      padding: 25px var(--pad);

      border-right: 1px solid rgba(255,255,255,0.12);
    }

    .fact strong {
      margin-bottom: 8px;

      font-family: var(--serif);
      font-size: clamp(28px, 3vw, 50px);
      font-weight: 400;
      line-height: 1;
    }

    .fact small {
      opacity: 0.72;

      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.12em;
      text-transform: uppercase;
    }

    /* =========================================================
       IMAGE COMPONENTS
    ========================================================= */

    .editorial-image {
      overflow: hidden;
      background: #dad7cf;
    }

    .editorial-image img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .ratio-wide {
      aspect-ratio: 16 / 9;
    }

    .ratio-tall {
      aspect-ratio: 4 / 5;
    }

    .ratio-square {
      aspect-ratio: 1;
    }

    .caption {
      display: flex;
      justify-content: space-between;
      gap: 20px;

      padding: 11px 0;

      border-top: 1px solid var(--line);

      color: var(--muted);

      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
    }

    /* =========================================================
       SUMMARY
    ========================================================= */

    .summary-grid {
      display: grid;
      grid-template-columns: repeat(4, 1fr);

      margin-top: 60px;

      border-top: 1px solid var(--line);
      border-left: 1px solid var(--line);
    }

    .summary-grid article {
      padding: 25px;

      border-right: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
    }

    .summary-grid strong {
      display: block;

      font-family: var(--serif);
      font-size: 34px;
      font-weight: 400;
    }

    .summary-grid span {
      font-size: 12px;
      color: var(--muted);
    }

    /* =========================================================
       FLOWS
    ========================================================= */

    .flow {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;

      margin: 35px 0;
    }

    .flow span {
      padding: 10px 12px;

      border: 1px solid var(--line);

      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.08em;
      text-transform: uppercase;
    }

    /* =========================================================
       CURRENT SITE
    ========================================================= */

    .site-layout {
      display: grid;
      grid-template-columns: 1.25fr 0.75fr;
      gap: 55px;
      align-items: start;
    }

    .site-photo {
      aspect-ratio: 4 / 3;
      object-fit: cover;
      background: #ddd;
    }

    .annotations {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 1px;

      margin-top: 1px;

      background: var(--line);
    }

    .annotations span {
      padding: 13px;

      background: var(--paper);

      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .terrain {
      margin-top: 70px;
    }

    .terrain-scroll {
      overflow-x: auto;

      background: white;

      border: 1px solid var(--line);
    }

    .terrain-scroll img {
      min-width: 900px;
    }

    .story-rail {
      display: grid;
      grid-template-columns: repeat(5, 1fr);

      gap: 1px;

      margin-top: 55px;

      background: var(--line);
    }

    .story-rail > div {
      padding: 20px;

      background: var(--paper);
    }

    .story-rail b {
      display: block;

      font-family: var(--serif);
      font-size: 31px;
      font-weight: 400;
      color: var(--bronze-text);
    }

    .story-rail span {
      font-size: 10px;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
    }

    .executed-codes {
      display: flex;
      flex-wrap: wrap;
      gap: 8px;

      margin: 20px 0;
    }

    .executed-codes span {
      min-width: 56px;

      padding: 10px;

      border: 1px solid var(--line);

      text-align: center;
    }

    /* =========================================================
       QUANTITIES
    ========================================================= */

    .quantity-list {
      margin-top: 40px;

      border-top: 1px solid var(--line);
    }

    .quantity-row {
      display: grid;
      grid-template-columns: 1fr auto;

      gap: 25px;

      padding: 15px 0;

      border-bottom: 1px solid var(--line);

      align-items: baseline;
    }

    .quantity-copy {
      display: flex;
      gap: 18px;
      align-items: baseline;
    }

    .quantity-copy small {
      color: var(--muted);

      font-size: 9px;
      font-weight: 700;
      letter-spacing: 0.08em;
    }

    .quantity-value {
      font-family: var(--serif);
      font-size: 22px;
      white-space: nowrap;
    }

    /* =========================================================
       STRATEGY
    ========================================================= */

    .critical-path {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 7px;

      margin-top: 40px;
    }

    .critical-path span {
      padding: 12px 14px;

      border: 1px solid var(--line);

      font-size: 10px;
      font-weight: 700;
      letter-spacing: 0.07em;
      text-transform: uppercase;
    }

    .arrow {
      color: var(--bronze-text);
    }

    .interfaces {
      display: grid;
      grid-template-columns: repeat(4, 1fr);

      gap: 1px;

      margin-top: 55px;

      background: var(--line);
    }

    .interfaces div {
      padding: 22px;

      background: var(--paper);

      font-family: var(--serif);
      font-size: 21px;
    }

    /* =========================================================
       MATERIALS
    ========================================================= */

    .material-block {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;

      margin: 80px 0;

      align-items: center;
    }

    .material-block:nth-child(even) .material-visual {
      order: 2;
    }

    .material-placeholder {
      min-height: 440px;

      display: flex;
      align-items: end;

      padding: 26px;

      color: white;

      background:
        linear-gradient(
          150deg,
          #776f61,
          #332f29 65%,
          #181a17
        );
    }

    .material-placeholder.alt {
      background:
        linear-gradient(
          150deg,
          #bbb1a0,
          #7b7468 45%,
          #3d443d
        );
    }

    .material-placeholder.dark {
      background:
        linear-gradient(
          145deg,
          #373934,
          #141714
        );
    }

    .material-placeholder span {
      max-width: 280px;

      font-family: var(--serif);
      font-size: 32px;
    }

    .spec {
      margin-top: 26px;

      border-top: 1px solid var(--line);
    }

    .spec-row {
      display: flex;
      justify-content: space-between;
      gap: 25px;

      padding: 12px 0;

      border-bottom: 1px solid var(--line);

      font-size: 13px;
    }

    .spec-row span:last-child {
      color: var(--muted);
      text-align: right;
    }

    .decision-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 1px;

      margin-top: 60px;

      background: var(--line);
    }

    .decision-grid article {
      padding: 24px;

      background: var(--paper);
    }

    .decision-grid h3 {
      margin: 14px 0 8px;

      font-family: var(--serif);
      font-size: 28px;
      font-weight: 400;
    }

    .decision-grid p {
      margin-bottom: 0;

      color: var(--muted);
      font-size: 13px;
    }

    /* =========================================================
       BUDGET
    ========================================================= */

    .cost-primary {
      display: grid;
      grid-template-columns: 1.5fr 0.7fr;

      gap: 70px;

      align-items: end;

      padding-top: 35px;

      border-top: 1px solid var(--line);
    }

    .cost-range {
      display: block;

      font-family: var(--serif);
      font-size: clamp(62px, 9vw, 128px);
      font-weight: 400;
      line-height: 0.9;
      letter-spacing: -0.06em;
    }

    .cost-target {
      display: block;

      font-family: var(--serif);
      font-size: clamp(40px, 5vw, 70px);
      font-weight: 400;
    }

    .cost-copy {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 42px;

      margin: 50px 0;
    }

    .cost-warning {
      padding: 20px;

      border: 1px solid var(--bronze);

      color: var(--muted);
    }

    .drivers {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 1px;

      margin: 40px 0;

      background: var(--line);
    }

    .drivers span {
      padding: 17px;

      background: var(--paper);

      font-size: 12px;
    }

    .pem {
      margin-top: 80px;
      padding-top: 32px;

      border-top: 1px solid var(--bronze);
    }

    .pem strong {
      display: block;

      font-family: var(--serif);
      font-size: clamp(36px, 5vw, 60px);
      font-weight: 400;
    }

    .allowances {
      display: grid;
      grid-template-columns: repeat(5, 1fr);

      gap: 1px;

      background: var(--line);
    }

    .allowance {
      padding: 20px;

      background: var(--paper);
    }

    .allowance strong {
      display: block;

      font-family: var(--serif);
      font-size: 25px;
      font-weight: 400;
    }

    /* =========================================================
       BOQ
    ========================================================= */

    .boq {
      margin-top: 70px;
    }

    .boq-row {
      display: grid;
      grid-template-columns: 45px 1fr 125px;

      gap: 16px;

      align-items: center;

      padding: 10px 0;

      border-top: 1px solid var(--line);

      font-size: 12px;
    }

    .boq-label {
      position: relative;

      padding-bottom: 9px;
    }

    .boq-bar {
      position: absolute;

      bottom: 0;
      left: 0;

      height: 2px;

      background: var(--bronze);
    }

    .boq-price {
      text-align: right;
      white-space: nowrap;
    }

    /* =========================================================
       PROCUREMENT
    ========================================================= */

    .procurement-grid {
      display: grid;
      grid-template-columns: repeat(2, 1fr);

      gap: 1px;

      margin-top: 45px;

      background: var(--line);
    }

    .procurement-card {
      padding: 22px;

      background: var(--paper);
    }

    .procurement-card h3 {
      margin: 10px 0;

      font-family: var(--serif);
      font-size: 28px;
      font-weight: 400;
    }

    /* =========================================================
       PROGRAMME
    ========================================================= */

    .programme-meta {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 60px;

      margin-bottom: 50px;
    }

    .programme-number {
      font-family: var(--serif);
      font-size: clamp(80px, 11vw, 150px);
      line-height: 0.9;
    }

    .procurement-buttons {
      display: flex;
      flex-wrap: wrap;
      gap: 7px;

      margin: 25px 0;
    }

    .procurement-buttons button {
      padding: 9px 11px;

      border: 1px solid rgba(255,255,255,0.28);

      background: transparent;
      color: white;
    }

    .procurement-buttons button.active {
      background: white;
      color: var(--dark);
    }

    .programme-note {
      min-height: 55px;

      color: #bbbdb5;
      font-size: 13px;
    }

    .gantt-scroll {
      overflow-x: auto;
    }

    .gantt {
      min-width: 1000px;
    }

    .months-row,
    .gantt-row {
      display: grid;
      grid-template-columns: 250px 1fr;
    }

    .months {
      display: grid;
      grid-template-columns: repeat(24, 1fr);

      color: #999;
      font-size: 9px;
    }

    .months span {
      text-align: center;
    }

    .gantt-row {
      min-height: 55px;

      border-top: 1px solid var(--line-dark);

      transition: opacity 0.25s ease;
    }

    .gantt-label {
      padding: 10px 15px 10px 0;

      font-size: 11px;
    }

    .gantt-label strong {
      display: block;
    }

    .gantt-label small {
      color: #999;
    }

    .gantt-track {
      position: relative;

      background:
        repeating-linear-gradient(
          90deg,
          transparent,
          transparent calc(100% / 24 - 1px),
          rgba(255,255,255,0.055) calc(100% / 24 - 1px),
          rgba(255,255,255,0.055) calc(100% / 24)
        );
    }

    .gantt-bar {
      position: absolute;

      top: 20px;

      height: 12px;

      background: #a99979;
    }

    .gantt-row.dimmed {
      opacity: 0.22;
    }

    .gantt-row.highlight .gantt-bar {
      top: 17px;

      height: 18px;

      background: white;
    }

    .scenarios {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 1px;

      margin-top: 45px;

      background: rgba(255,255,255,0.15);
    }

    .scenario {
      padding: 22px;

      background: var(--dark);
    }

    .scenario strong {
      display: block;

      font-family: var(--serif);
      font-size: 40px;
      font-weight: 400;
    }

    /* =========================================================
       RISK / KPI
    ========================================================= */

    .risk-grid {
      display: grid;
      grid-template-columns: 1fr 1fr;

      gap: 1px;

      margin-top: 40px;

      background: var(--line);
    }

    .risk-grid article {
      padding: 25px;

      background: var(--paper);
    }

    .risk-grid h3 {
      margin: 0 0 10px;

      font-family: var(--serif);
      font-size: 29px;
      font-weight: 400;
    }

    .risk-grid p {
      margin-bottom: 0;

      color: var(--muted);
    }

    .kpis {
      display: grid;
      grid-template-columns: repeat(3, 1fr);

      gap: 15px;

      margin-top: 40px;
    }

    .kpi {
      padding-top: 12px;

      border-top: 1px solid var(--line);

      color: var(--muted);
    }

    /* =========================================================
       CONCLUSION
    ========================================================= */

    .conclusion {
      position: relative;

      min-height: 75vh;

      display: grid;
      align-items: end;

      overflow: hidden;

      color: white;

      background:
        radial-gradient(circle at 60% 20%, #687168, transparent 30%),
        linear-gradient(140deg, #353e35, #101411);
    }

    .conclusion::after {
      content: "";
      position: absolute;
      inset: 0;

      background:
        linear-gradient(
          180deg,
          rgba(0,0,0,0.1),
          rgba(0,0,0,0.72)
        );
    }

    .conclusion-content {
      position: relative;
      z-index: 2;

      width: 100%;
      max-width: var(--max);
      margin: auto;

      padding: 70px var(--pad);
    }

    .conclusion h2 {
      margin: 0;

      max-width: 1150px;

      font-family: var(--serif);
      font-size: clamp(46px, 7vw, 96px);
      font-weight: 400;
      line-height: 0.98;
      letter-spacing: -0.035em;
    }

    footer {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 50px;

      padding: 42px var(--pad);

      border-top: 1px solid var(--line);

      color: var(--muted);
      font-size: 12px;
    }

    /* =========================================================
